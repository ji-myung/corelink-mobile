{
  "name": "corelink-mobile",
  "version": "0.1.0",
  "description": "강지명 (Corelink) 모바일 명함",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "print": "node design/print/gen-print.mjs",
    "print:samples": "node design/print/gen-print.mjs --samples",
    "print:edit": "node design/print/editor.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ji-myung/corelink-mobile.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ji-myung/corelink-mobile/issues"
  },
  "homepage": "https://github.com/ji-myung/corelink-mobile#readme",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "private": true
}
